APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL es la base de datos de referencia del proyecto (dev y producción).
# En desarrollo local corre vía Docker (ver docker-compose-phpmyadmin.yml);
# Laravel/PHP y Node/Vite corren nativos en el host, no en contenedor.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wpbottrainer
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Meta (WhatsApp Cloud API) — controles P0 de lanzamiento.
# META_APP_SECRET: secreto de la App de Meta (Developers Console), GLOBAL
# para toda la plataforma — nunca por tenant. Usado para verificar
# X-Hub-Signature-256 en el webhook (App\Http\Middleware\VerifyMetaWebhookSignature).
META_APP_SECRET=
# log-only: registra advertencia si la firma es inválida/ausente, pero deja
# pasar la petición (sin cambio de comportamiento funcional). strict: rechaza
# con 401 cualquier firma inválida/ausente. Empezar siempre en log-only hasta
# confirmar en logs reales que Meta está firmando las entregas.
META_WEBHOOK_SIGNATURE_MODE=log-only

# Rate limiting del webhook de WhatsApp.
WHATSAPP_WEBHOOK_IP_RATE_LIMIT=120
WHATSAPP_CONTACT_RATE_LIMIT_MAX=20
WHATSAPP_CONTACT_RATE_LIMIT_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
